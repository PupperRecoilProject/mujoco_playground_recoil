<!-- 
  ===================================================================================
  ==                   Pupper V2 - Sim2Real Model (Final Version)                  ==
  ===================================================================================
-->
<mujoco model="pupper_v2">
  <compiler angle="radian" autolimits="true"/>

  <option timestep="0.002" gravity="0 0 -9.81" integrator="RK4">
    <flag eulerdamp="disable"/>
  </option>

  <default>
    <default class="pupper">
      <joint armature="0.01" damping="0.5" solimplimit="0.9 0.99 0.001" solreflimit="0.02 1"/>
      <geom type="mesh" contype="0" conaffinity="0" group="2" rgba="0.8 0.6 .4 1"/>
      <general biastype="affine" gainprm="35.0" biasprm="0 -35.0 0"/>
    </default>
    <default class="pupper-foot">
      <geom type="sphere" contype="1" conaffinity="1" group="3" friction="0.8 0.1 0.1" solimp="0.9 0.99 0.001" solref="0.02 1"/>
    </default>
  </default>

  <asset>
    <mesh name="body" file="mesh/body.stl" scale="0.001 0.001 0.001"/>
    <mesh name="Hip_L" file="mesh/Hip_L.stl" scale="0.001 0.001 0.001"/>
    <mesh name="Hip_R" file="mesh/Hip_R.stl" scale="0.001 0.001 0.001"/>
    <mesh name="Upper_Leg_L" file="mesh/Upper_Leg_L.stl" scale="0.001 0.001 0.001"/>
    <mesh name="Upper_Leg_R" file="mesh/Upper_Leg_R.stl" scale="0.001 0.001 0.001"/>
    <mesh name="Lower_Leg_L" file="mesh/Lower_Leg_L.stl" scale="0.001 0.001 0.001"/>
    <mesh name="Lower_Leg_R" file="mesh/Lower_Leg_R.stl" scale="0.001 0.001 0.001"/>
  </asset>

  <worldbody>
    
    <body name="torso" pos="0 0 0.2" childclass="pupper">
      <freejoint name="root"/>
      <camera name="track" pos="1.5 -1.5 0.8" xyaxes="0.707 0.707 0 -0.354 0.354 0.866" mode="trackcom"/>
      <inertial pos="0.00109 -0.074 0" mass="0.7833" diaginertia="0.0003688 0.002508 0.002674"/>
      <geom name="torso_visual" mesh="body"/>
      <site name="imu_site" pos="0 0 0" size="0.01"/>

      <!-- Legs -->
      <body name="leg_front_right" pos="-0.046891 -0.203946 -0.0064"><joint name="abduction_front_right" type="hinge" axis="0 1 0" range="-1.0472 1.0472"/><geom mesh="Hip_R"/><body name="upper_leg_front_right" pos="-0.037 0.028 0"><joint name="hip_front_right" type="hinge" axis="1 0 0" range="-0.76166 3.81442"/><geom mesh="Upper_Leg_R"/><body name="lower_leg_front_right" pos="0 0 -0.08"><joint name="knee_front_right" type="hinge" axis="1 0 0" range="-0.78540 1.65806"/><geom mesh="Lower_Leg_R"/><site name="foot_front_right" pos="0.003475 0 -0.11" size="0.009525"/><geom name="foot_front_right_collision" class="pupper-foot" size="0.0175" pos="0.003475 0 -0.11"/></body></body></body>
      <body name="leg_front_left" pos="0.047109 -0.203946 -0.0064"><joint name="abduction_front_left" type="hinge" axis="0 1 0" range="-1.0472 1.0472"/><geom mesh="Hip_L"/><body name="upper_leg_front_left" pos="0.037 0.028 0"><joint name="hip_front_left" type="hinge" axis="1 0 0" range="-0.76166 3.81442"/><geom mesh="Upper_Leg_L"/><body name="lower_leg_front_left" pos="0 0 -0.08"><joint name="knee_front_left" type="hinge" axis="1 0 0" range="-0.78540 1.65806"/><geom mesh="Lower_Leg_L"/><site name="foot_front_left" pos="-0.003475 0 -0.11" size="0.009525"/><geom name="foot_front_left_collision" class="pupper-foot" size="0.0175" pos="-0.003475 0 -0.11"/></body></body></body>
      <body name="leg_hind_right" pos="-0.046896 -0.004096 -0.0064"><joint name="abduction_hind_right" type="hinge" axis="0 1 0" range="-1.0472 1.0472"/><geom mesh="Hip_R"/><body name="upper_leg_hind_right" pos="-0.037 0.028 0"><joint name="hip_hind_right" type="hinge" axis="1 0 0" range="-0.76166 3.81442"/><geom mesh="Upper_Leg_R"/><body name="lower_leg_hind_right" pos="0 0 -0.08"><joint name="knee_hind_right" type="hinge" axis="1 0 0" range="-0.78540 1.65806"/><geom mesh="Lower_Leg_R"/><site name="foot_hind_right" pos="0.003475 0 -0.11" size="0.009525"/><geom name="foot_hind_right_collision" class="pupper-foot" size="0.0175" pos="0.003475 0 -0.11"/></body></body></body>
      <body name="leg_hind_left" pos="0.047104 -0.004096 -0.0064"><joint name="abduction_hind_left" type="hinge" axis="0 1 0" range="-1.0472 1.0472"/><geom mesh="Hip_L"/><body name="upper_leg_hind_left" pos="0.037 0.028 0"><joint name="hip_hind_left" type="hinge" axis="1 0 0" range="-0.76166 3.81442"/><geom mesh="Upper_Leg_L"/><body name="lower_leg_hind_left" pos="0 0 -0.08"><joint name="knee_hind_left" type="hinge" axis="1 0 0" range="-0.78540 1.65806"/><geom mesh="Lower_Leg_L"/><site name="foot_hind_left" pos="-0.003475 0 -0.11" size="0.009525"/><geom name="foot_hind_left_collision" class="pupper-foot" size="0.0175" pos="-0.003475 0 -0.11"/></body></body></body>
    </body>
  </worldbody>

  <actuator>
    <general class="pupper" name="FR_abduction" joint="abduction_front_right"/>
    <general class="pupper" name="FR_hip"       joint="hip_front_right"/>
    <general class="pupper" name="FR_knee"      joint="knee_front_right"/>
    
    <general class="pupper" name="FL_abduction" joint="abduction_front_left"/>
    <general class="pupper" name="FL_hip"       joint="hip_front_left"/>
    <general class="pupper" name="FL_knee"      joint="knee_front_left"/>
    
    <general class="pupper" name="HR_abduction" joint="abduction_hind_right"/>
    <general class="pupper" name="HR_hip"       joint="hip_hind_right"/>
    <general class="pupper" name="HR_knee"      joint="knee_hind_right"/>
    
    <general class="pupper" name="HL_abduction" joint="abduction_hind_left"/>
    <general class="pupper" name="HL_hip"       joint="hip_hind_left"/>
    <general class="pupper" name="HL_knee"      joint="knee_hind_left"/>
  </actuator>
  
  <sensor>
    <jointpos name="joint_pos" joint="abduction_front_right"/> <jointpos joint="hip_front_right"/> <jointpos joint="knee_front_right"/>
    <jointpos joint="abduction_front_left"/>  <jointpos joint="hip_front_left"/>  <jointpos joint="knee_front_left"/>
    <jointpos joint="abduction_hind_right"/>  <jointpos joint="hip_hind_right"/>  <jointpos joint="knee_hind_right"/>
    <jointpos joint="abduction_hind_left"/>   <jointpos joint="hip_hind_left"/>   <jointpos joint="knee_hind_left"/>
    
    <accelerometer name="imu_accel" site="imu_site"/>
    <gyro name="imu_gyro" site="imu_site"/>
    
    <framequat name="torso_quat" objtype="body" objname="torso"/>
    <framepos name="torso_pos" objtype="body" objname="torso"/>
    <framelinvel name="torso_lin_vel" objtype="body" objname="torso"/>
    <frameangvel name="torso_ang_vel" objtype="body" objname="torso"/>

    <jointvel name="joint_vel" joint="abduction_front_right"/> <jointvel joint="hip_front_right"/> <jointvel joint="knee_front_right"/>
    <jointvel joint="abduction_front_left"/>  <jointvel joint="hip_front_left"/>  <jointvel joint="knee_front_left"/>
    <jointvel joint="abduction_hind_right"/>  <jointvel joint="hip_hind_right"/>  <jointvel joint="knee_hind_right"/>
    <jointvel joint="abduction_hind_left"/>   <jointvel joint="hip_hind_left"/>   <jointvel joint="knee_hind_left"/>
    
    <actuatorfrc name="actuator_forces" actuator="FR_abduction"/> <actuatorfrc actuator="FR_hip"/> <actuatorfrc actuator="FR_knee"/>
    <actuatorfrc actuator="FL_abduction"/>  <actuatorfrc actuator="FL_hip"/>  <actuatorfrc actuator="FL_knee"/>
    <actuatorfrc actuator="HR_abduction"/>  <actuatorfrc actuator="HR_hip"/>  <actuatorfrc actuator="HR_knee"/>
    <actuatorfrc actuator="HL_abduction"/>   <actuatorfrc actuator="HL_hip"/>   <actuatorfrc actuator="HL_knee"/>
    
    <touch name="foot_contacts" site="foot_front_right"/>
    <touch site="foot_front_left"/>
    <touch site="foot_hind_right"/>
    <touch site="foot_hind_left"/>
    
    <subtreecom name="subtree_com" body="torso"/>
  </sensor>

  <keyframe>
    <key name="home" qpos="0 0 0.2 1 0 0 0  0 0.4 -0.8  0 0.4 -0.8  0 0.4 -0.8  0 0.4 -0.8"/>
  </keyframe>
</mujoco>